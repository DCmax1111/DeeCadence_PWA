# Supabase (client)
NEXT_PUBLIC_SUPABASE_URL=https://<your-project>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# Supabase service role key (server-side only)
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# App
NEXT_PUBLIC_APP_URL=http://localhost:3001

# Manual transfer checkout
# Used to quote NGN prices when a USD plan is paid into a NGN account.
USD_NGN_RATE=1500

# Optional owner notification after the customer submits payment proof.
OWNER_NOTIFICATION_EMAIL=owner@example.com
RESEND_API_KEY=
NOTIFICATION_FROM_EMAIL=DeeCash <onboarding@resend.dev>

# Optional owner-only confirmation endpoint.
# Send this as the x-owner-token header to /api/admin/payments.
OWNER_ADMIN_TOKEN=change-this-long-random-token
