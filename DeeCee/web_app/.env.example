# DeeCee browser app
NEXT_PUBLIC_APP_URL=http://localhost:3002

# Supabase server API. Keep the service role key server-side only.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-your-public-anon-key
SUPABASE_SERVICE_ROLE_KEY=replace-with-your-server-only-service-role-key

# Payment checkout. Keep sandbox until the full provider account is verified.
PAYMENT_PROVIDER=sandbox
PAYMENT_WEBHOOK_SECRET=replace-with-a-long-random-webhook-secret
PAYMENT_SANDBOX_BASE_URL=http://localhost:3002

# Manual transfer fallback notifications
OWNER_NOTIFICATION_EMAIL=dominiquecreations24@gmail.com
RESEND_API_KEY=replace-with-resend-api-key-or-leave-empty
NOTIFICATION_FROM_EMAIL=DeeCee <verified-sender@your-domain.com>

# Owner-only confirmation endpoint.
# Send as x-owner-token to /api/admin/payments.
OWNER_ADMIN_TOKEN=replace-with-a-long-random-owner-token
